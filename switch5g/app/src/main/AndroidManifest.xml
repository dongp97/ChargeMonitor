<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 核心权限：普通 App 无法直接获得，需电脑 adb 一次性授予 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 内置定时用 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主入口：启动即切换，随后立即退出（透明主题，无感知） -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/TransparentTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 校准 / 设置页：桌面长按图标的快捷方式进入 -->
        <activity
            android:name=".CalibrationActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="com.dongp.switch5g.CALIBRATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SwitchReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dongp.switch5g.ACTION_ON" />
                <action android:name="com.dongp.switch5g.ACTION_OFF" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 小米快速重启 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- 应用被重装/更新后闹钟会失效，需要重新注册 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
