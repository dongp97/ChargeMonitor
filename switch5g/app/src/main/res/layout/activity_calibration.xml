<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#33000000" />

        <Button
            android:id="@+id/btn_cal_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 记录：当前 = 5G 开启状态" />

        <Button
            android:id="@+id/btn_cal_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② 记录：当前 = 5G 关闭状态" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即执行一次切换（测试效果）" />

        <Button
            android:id="@+id/btn_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="复制诊断信息（排查用）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="内置定时（可选，与自动任务二选一）"
            android:textSize="15sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="启用每日定时" />

        <TimePicker
            android:id="@+id/time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:timePickerMode="spinner" />

        <Button
            android:id="@+id/btn_save_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存定时" />

        <Button
            android:id="@+id/btn_clear_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="取消定时" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="#33000000" />

        <TextView
            android:id="@+id/tv_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
